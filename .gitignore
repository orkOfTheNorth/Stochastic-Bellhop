# Stochastic Bellhop project — Bellhop run cache (~16 GB of .mat files)
stochastic_TL_maps_project/Cache/

# All .mat binary results (large files not suitable for version control)
*.mat

# Bellhop runtime files (generated during each run)
*.bty
*.env
*.prt
*.shd
*.arr

# Log files
*.log
update_all_log.txt
*_log.txt

# MATLAB session files
*.asv
*.m~

# Generated figures (regenerate from MATLAB scripts)
*.png
*.fig

# Allow pipeline output figures to be committed
!stochastic_TL_maps_project/Methods/**/*.png
!stochastic_TL_maps_project/validation/analytical/figures/*.png
!stochastic_TL_maps_project/Methods/Comparison/**/*.png
!stochastic_TL_maps_project/Methods/Delta/**/*.png

