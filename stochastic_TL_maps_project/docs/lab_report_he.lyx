\begin_layout Paragraph
מוטיבציה לבחירת מודל LN3.
\end_layout

\begin_layout Standard
הבחירה בהתפלגות לוגנורמלית תלת-פרמטרית ל-TL מונעת על ידי טיעונים פיזיקליים:
\end_layout

\begin_layout Standard
ראשית,
 TL מבוטא כבר בסקאלה לוגריתמית (dB):
 
\begin_inset Formula $\mathrm{TL}=-20\log_{10}(|p|/p_{0})$
\end_inset

.
 כל מבנה כפלי בשדה הלחץ ממופה לכן למבנה חיבורי ב-TL,
 ומעדיף התפלגויות ממשפחת הלוגנורמלי.
\end_layout

\begin_layout Standard
שנית,
 בגלידה רב-מודלית,
 הלחץ המקובל הוא סכום קוהרנטי של 
\begin_inset Formula $M$
\end_inset

 תרומות מודים נורמליים;
 עבור 
\begin_inset Formula $M$
\end_inset

 גדול,
 ה-
\lang english
CLT
\lang hebrew
 מציע ש-
\begin_inset Formula $|p|$
\end_inset

 מתפלג בערך כרייליי,
 שממיר ל-TL לוגנורמלי בערך.
\end_layout

\begin_layout Standard
שלישית,
 ל-TL יש תחתון פיזיקלי:
 התפשטות גיאומטרית מטילה הפסד מינימלי 
\begin_inset Formula $\mathrm{TL}_{\min}>0\,\mathrm{dB}$
\end_inset

.
 הלוגנורמלי התלת-פרמטרי 
\begin_inset Formula 
\begin{equation}
X-\gamma\sim\mathrm{LN2},\quad\gamma=0.95\,\min(\text{samples}),
\end{equation}

\end_inset

מקודד במפורש את הרצפה הפיזיקלית דרך פרמטר ההזזה 
\begin_inset Formula $\gamma$
\end_inset

.
 הפרמטרים 
\begin_inset Formula $(\hat{\mu},\hat{\sigma})$
\end_inset

 מוערכים ב-
\lang english
MLE
\lang hebrew
 דרך 
\family typewriter
lognfit
\family default
 (עדיף על 
\lang english
MOM
\lang hebrew
,
 שבדרך כלל פחות יעיל ב-10–30%):
 
\begin_inset Formula 
\begin{equation}
\hat{P}_{\mathrm{shadow}}^{\mathrm{LN3}}(\mathbf{x})=\Phi\!\left(\frac{\ln(\mathrm{FOM}-\hat{\gamma})-\hat{\mu}}{\hat{\sigma}}\right).
\end{equation}

\end_inset


\end_layout

