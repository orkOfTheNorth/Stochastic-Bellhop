\end_layout

\begin_layout Standard
\begin_inset CommandInset label
LatexCommand label
name "sec:delta"

\end_inset


\end_layout

\begin_layout Paragraph
הערת מינוח.
\end_layout

\begin_layout Standard
המונח 
\emph on
שיטת דלתא
\emph default
 כאן מתייחס ללינאריזציה באמצעות חשבון הפרעות (פיתוח טיילור מסדר ראשון של פלט המודל סביב וקטור הפרמטרים הנומינלי),
 הידועה גם כ-
\lang english
FOSM
\lang hebrew
 בתחום אמינות קונסטרוקציה וכלינאריזציית 
\lang english
GUM
\lang hebrew
 במטרולוגיה.
\end_layout

\begin_layout Standard
שיטת דלתא מסדר 1 מקרבת את השונות כ:
 
\begin_inset Formula 
\begin{equation}
\Var_{1}[\TL]\;\approx\;\sum_{i}J_{i}^{2}\,\sigma_{i}^{2},\qquad J_{i}=\frac{\partial\TL}{\partial\theta_{i}}\bigg|_{\boldsymbol{\theta}_{0}},\label{eq:delta1}
\end{equation}

\end_inset

כאשר הג'קוביאנים 
\begin_inset Formula $J_{i}$
