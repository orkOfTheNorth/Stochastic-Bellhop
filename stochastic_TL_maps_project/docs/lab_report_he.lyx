\begin_layout Standard
השדה האקוסטי בים מתואר על ידי משוואת הלמהולץ בגיאומטריה סילינדרית סימטרית (
\begin_inset Formula $r$
\end_inset

-
\begin_inset Formula $z$
\end_inset

) (גיאומטריה זו היא המופיעה בסימולציית BELLHOP כתמונת חתך ):
 
\begin_inset Formula 
\begin{equation}
\nabla^{2}p+k^{2}(r,z)\,p=-S(r,z),\quad k=\frac{2\pi f}{c(r,z)},
\end{equation}

\end_inset

כאשר 
\begin_inset Formula $p$
\end_inset

 הוא האמפליטודה המרוכבת של הלחץ,
 
\begin_inset Formula $f$
\end_inset

 הוא התדר,
 
\begin_inset Formula $c(r,z)$
\end_inset

 הוא מהירות הקול המקומית,
 ו-
\begin_inset Formula $S$
\end_inset

 הוא אבר התלוי בעוצמת המקור.
 הפסד ההעברה מוגדר כ:
 
\begin_inset Formula 
\begin{equation}
\TL(r,z)=-20\log_{10}\!\left(\frac{|p(r,z)|}{|p_{\mathrm{ref}}|}\right)\quad[\text{dB}].
\end{equation}

\end_inset


\lang english
Bellhop
\lang hebrew

\begin_inset space ~
\end_inset


\begin_inset CommandInset citation
LatexCommand cite
key "porter1987bellhop"
literal "false"

\end_inset

 פותר משוואה זו בעזרת קירוב קרניים:
 האנרגיה אקוסטית מתפשטת לאורך הקרניים,
 כאשר כל קרן נושאת מעטפת גאוסיאנית המדמה תרחיש עקיפה.
 המודל מטפל אוטומטית בהחזרות מקרקעית הים,
 החזרות מהמשטח ושבירה דרך גרדיאנט מהירות הקול.
 בפרויקיט זה התחייסנו אל ההדמייה כקופסא שחורה ללא התעמקות במימושה.
 
