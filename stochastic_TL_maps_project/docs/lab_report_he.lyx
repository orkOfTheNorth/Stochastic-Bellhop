\begin_layout Subsubsection
התכנסות מאמד MC
\end_layout

\begin_layout Standard
\begin_inset CommandInset label
LatexCommand label
name "sec:mc_conv"

\end_inset


\end_layout

\begin_layout Standard
עבור משתנה אקראי סקלרי 
\begin_inset Formula $Y$
\end_inset

 עם שונות סופית,
 הממוצע המדגמי 
\begin_inset Formula $\bar{Y}_{N}$
\end_inset

 מתכנס אל 
\begin_inset Formula $\mu_{Y}$
\end_inset

 בקצב 
\lang english
CLT
\lang hebrew
 הקלאסי 
\begin_inset Formula $\mathrm{RMSE}(\bar{Y}_{N})=\sigma_{Y}/\sqrt{N}$
\end_inset

.
 השונות המדגמית 
\begin_inset Formula $S_{N}^{2}$
\end_inset

 מתכנסת באותו קצב אסימפטוטי,
 אך עם מקדם גדול יותר:
 
\begin_inset Formula 
\begin{equation}
\mathrm{Var}(S_{N}^{2})\;=\;\frac{2\sigma_{Y}^{4}}{N-1},\label{eq:var_of_var}
\end{equation}

\end_inset

לכן השגיאה היחסית של 
\begin_inset Formula $S_{N}^{2}$
\end_inset

 היא 
\begin_inset Formula $\sqrt{2/(N-1)}/C_{V}^{2}$
\end_inset

 כאשר 
\begin_inset Formula $C_{V}=\sigma_{Y}/\mu_{Y}$
\end_inset

 הוא מקדם הווריאציה.
 ב-
\begin_inset Formula $N=1000$
\end_inset

 ועבור ההתפלגות הרחבה ביותר (נורמלי 10%),
 שגיאת ה-RMSE היחסית של מאמד השונות המדגמית היא 
\begin_inset Formula $\approx4.5\%$
\end_inset

,
 בתוך יעד ה-
\begin_inset Formula $\lesssim5\%$
\end_inset

.
\end_layout

